# Copy this file to .env.local and fill in your Supabase credentials.
# In Vercel, add these as Environment Variables in the project settings.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: override where audio files are served from (default = /media/...)
# Set this to a CDN or Supabase Storage bucket URL for production.
# VITE_MEDIA_BASE_URL=https://your-cdn.example.com/media/Vocality_in_Guitar_Timbre_V.3
